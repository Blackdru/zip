# ZIP Server — Environment Variables

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Anti-Cheat ───────────────────────────────────────────────────────────────
MIN_SOLVE_TIME_MS=3000
ANTICHEAT_SCAN_CRON=0 2 * * *

# ─── Weekly Tournament ────────────────────────────────────────────────────────
# Cron: every Monday at 00:00 UTC
TOURNAMENT_RESET_CRON=0 0 * * 1
# Cron: every Sunday at 23:59 UTC (freeze)
TOURNAMENT_FREEZE_CRON=59 23 * * 0

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:19006
