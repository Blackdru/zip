{
  "name": "zip-server",
  "version": "1.0.0",
  "description": "ZIP Competitive Puzzle Platform — Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --runInBand",
    "cron": "ts-node src/cron/runner.ts",
    "migrate": "ts-node src/db/migrate.ts",
    "seed": "ts-node src/scripts/createWeeklyTournament.ts",
    "seed:puzzles": "ts-node src/scripts/seedInitialPuzzles.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.39.7",
    "bcryptjs": "2.4.3",
    "compression": "^1.8.1",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "7.2.0",
    "express-validator": "7.0.1",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "node-cron": "^4.2.1",
    "uuid": "^14.0.0",
    "winston": "3.12.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/compression": "1.7.5",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.12.7",
    "@types/node-cron": "3.0.11",
    "@types/supertest": "6.0.2",
    "@types/uuid": "9.0.8",
    "jest": "29.7.0",
    "supertest": "6.3.4",
    "ts-jest": "29.1.2",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.4.5"
  }
}
